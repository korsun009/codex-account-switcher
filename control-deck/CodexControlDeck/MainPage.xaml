<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CodexControlDeck.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CodexControlDeck.ViewModels"
    mc:Ignorable="d">

    <NavigationView x:Name="MainNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Пульт" Tag="deck" IsSelected="True">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Сценарии" Tag="actions">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Подключения" Tag="connections">
                <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid x:Name="DeckPanel" Padding="24,20,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Пульт управления" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Обновить" Click="Refresh_Click" VerticalAlignment="Center" AutomationProperties.Name="Обновить состояние" />
                </Grid>
                <InfoBar Grid.Row="1" Margin="0,16,0,0" IsOpen="True" IsClosable="False" Severity="Informational" Title="Активный профиль" Message="{x:Bind ViewModel.ActiveProfile, Mode=OneWay}" />
                <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Команды" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <GridView ItemsSource="{x:Bind ViewModel.Tiles}" IsItemClickEnabled="False" SelectionMode="None" HorizontalAlignment="Stretch">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="232" ItemHeight="126" /></ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DeckTileViewModel">
                                        <Button Width="220" Height="114" Tag="{x:Bind Id}" Click="Tile_Click" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Name}">
                                            <Grid Padding="4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="25" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="3" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260" /><ColumnDefinition Width="*" MinWidth="330" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Аккаунты Codex" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Accounts}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:AccountViewModel">
                                            <Button Tag="{x:Bind Name}" Click="Account_Click" HorizontalContentAlignment="Stretch" Margin="0,2" AutomationProperties.Name="{x:Bind DisplayName}">
                                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind DisplayName}" />
                                                    <TextBlock Grid.Column="1" Text="активный" Visibility="{x:Bind Active}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Text="Лимиты" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Limits}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:UsageViewModel">
                                            <Grid Padding="8,5" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Account}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Window}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Percent}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Reset}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ActionsPanel" Visibility="Collapsed" Padding="24,20,24,28" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="Сценарии" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Создавайте кнопки и голосовые команды без изменения кода." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button Content="Новый сценарий" Click="NewAction_Click" HorizontalAlignment="Stretch" />
                    <ListView x:Name="ActionsList" Grid.Row="1" Margin="0,10,0,0" ItemsSource="{x:Bind ViewModel.Actions}" SelectionChanged="Action_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ActionListItemViewModel">
                                <StackPanel Padding="4" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Kind}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ActionIdBox" Header="ID сценария" PlaceholderText="например, open-work" />
                            <TextBox x:Name="ActionNameBox" Grid.Column="1" Header="Название кнопки" PlaceholderText="Открыть рабочие приложения" />
                        </Grid>
                        <TextBox x:Name="ActionDescriptionBox" Header="Короткое описание" MaxLength="180" TextWrapping="Wrap" />
                        <ComboBox x:Name="ActionKindBox" Header="Что нужно сделать" SelectionChanged="ActionKind_SelectionChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Открыть программу" Tag="Program" />
                            <ComboBoxItem Content="Открыть сайт" Tag="Url" />
                            <ComboBoxItem Content="Запустить PowerShell-файл" Tag="PowerShellScript" />
                            <ComboBoxItem Content="Выполнить команду PowerShell (для опытных)" Tag="PowerShellCommand" />
                        </ComboBox>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ActionTargetBox" Header="Программа, сайт или сценарий" TextWrapping="Wrap" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Выбрать файл" Click="Browse_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBox x:Name="ActionArgumentsBox" Header="Параметры запуска" PlaceholderText="Один параметр на строку. Обычно поле можно оставить пустым." AcceptsReturn="True" MinHeight="74" TextWrapping="NoWrap" />
                        <TextBox x:Name="ActionAliasesBox" Header="Фразы для Алисы" PlaceholderText="Одна фраза на строку, например: открой рабочий набор" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="AllowRemoteToggle" Header="Показывать в Telegram и Алисе" OffContent="Только на этом ПК" OnContent="Удалённый запуск разрешён" Toggled="AllowRemote_Toggled" />
                        <CheckBox x:Name="ConfirmationCheck" Content="Всегда просить подтверждение перед удалённым запуском" />
                        <CheckBox x:Name="RemoteAcknowledgeCheck" Content="Я понимаю: удалённая команда выполнится с правами Windows API" />
                        <InfoBar x:Name="AdvancedWarning" IsOpen="False" IsClosable="False" Severity="Warning" Title="Расширенный режим" Message="Команда PowerShell выполняет введённый код. Используйте её только для собственных проверенных команд." />
                        <InfoBar x:Name="EditorMessage" IsOpen="False" IsClosable="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Сохранить" Click="SaveAction_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Проверить на этом ПК" Click="TestAction_Click" />
                            <Button Content="Удалить" Click="DeleteAction_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="ConnectionsPanel" Visibility="Collapsed" Padding="24,20,24,28" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel Spacing="4"><TextBlock Text="Подключения" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Проверка общего Windows API и автоматической синхронизации каналов." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <TextBox x:Name="ApiUrlBox" Header="Адрес Windows API" PlaceholderText="http://127.0.0.1:8765" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Секретный токен" Message="Токен читается из пользовательской переменной CODEX_REMOTE_API_TOKEN и не показывается в приложении." />
                    <Button Content="Сохранить и проверить" Click="SaveConnection_Click" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Windows API" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ApiStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Telegram и Алиса" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Токен API" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" x:Name="TokenStatusText" Margin="0,12,0,0" />
                    </Grid>
                    <TextBlock Text="Как работает синхронизация" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Сценарии сохраняются в профиле Windows. Windows API отдаёт Telegram и Алисе только название, фразы и признак подтверждения. Путь к программе, параметры и текст PowerShell не передаются на серверы." TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
